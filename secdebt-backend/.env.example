GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=sqlite+aiosqlite:///./codesentinel.db
# Origins allowed to call the API from another site (comma-separated).
# Not needed when the backend serves the frontend itself (same origin).
FRONTEND_ORIGIN=http://localhost:5173
# Anyone can create an account while this is true. Once your team has signed
# up on a public server, set it to false so strangers can't use your Gemini key.
ALLOW_SIGNUPS=true
UPLOAD_DIR=uploads
REPO_DIR=repos
MAX_FILE_SIZE_MB=50
MAX_REPO_SIZE_MB=200
# Code files to analyse (comma-separated extensions)
CODE_EXTENSIONS=.js,.ts,.jsx,.tsx,.py,.java,.go,.rb,.php,.cs,.cpp,.c,.h,.env,.yml,.yaml,.json,.toml,.tf
